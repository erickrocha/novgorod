{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build kremlin",
      "type": "shell",
      "command": "cargo build --bin kremlin",
      "options": {
        "cwd": "${workspaceFolder}/kremlin"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "run kremlin",
      "type": "shell",
      "command": "cargo run --bin kremlin",
      "options": {
        "cwd": "${workspaceFolder}/kremlin"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "start veche",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/veche"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:.*"
        }
      }
    }
  ]
}
